{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KDock",
  "version": "0.3.0",
  "identifier": "com.kyin.kdock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "KDock",
        "url": "splash.html",
        "width": 380,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#131B20"
      },
      {
        "label": "main",
        "title": "KDock",
        "decorations": false,
        "visible": false,
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
