    "test:flash": "node tests/flash-rom.unit.mjs",
    "test:lazy": "node tests/lazy-pages.vite-smoke.mjs",
    "test:vite:flash": "node tests/flash-bootloader.vite-smoke.mjs",
    "test:vite:reasoning": "node tests/reasoning-effort.vite-smoke.mjs",
    "test:vite:pages": "node tests/all-pages.vite-smoke.mjs",
    "test:vite:ui": "node tests/ui-polish.vite-smoke.mjs",
